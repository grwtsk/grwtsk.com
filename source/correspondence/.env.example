# Set these as secret environment variables. Do not commit actual values.
PORT=8080
# Volume mode needs no private GitHub repository or state token.
STATE_BACKEND=volume
STATE_DIR=/data/correspondence
# Railway volume only: prepare mounted directory, then drop to node.
RAILWAY_RUN_UID=0
# For optional private GitHub mode only:
# STATE_REPO=your-account/private-correspondence-state
# STATE_BRANCH=main
# GITHUB_STATE_TOKEN=
STATE_KEY_BASE64=
OPERATOR_TOKEN=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM=jacob@grwtsk.com
MAIL_PRIMARY_ADDRESS=jacob@grwtsk.com
# Optional verified forwarding target on dedicated receiving domain.
MAIL_PRIMARY_ALIAS=
MAIL_RECEIVE_DOMAIN=correspondence.grwtsk.com
OPENAI_API_KEY=
OPENAI_MODEL=
AUTHORIZED_OFFICES_JSON=[]
ENABLE_LIVE_SEND=false

# Optional: prepare one internal draft per cycle from approved Markdown; never sends.
ENABLE_AUTO_DRAFTS=false

# Optional internal quality suggestions from aggregate feedback only.
ENABLE_AUTO_QUALITY=false

# GitHub-first owner-only qualification; default deny.
ENABLE_GITHUB_FIRST=false
GITHUB_FIRST_ACTIVATED_AT=
ENABLE_OWNER_ROUTINE_ACKS=false
